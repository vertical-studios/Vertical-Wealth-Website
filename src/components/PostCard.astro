---
import { postUrl, readingTime, type Post } from "../lib/posts";
import { sized } from "../lib/img";
const { post } = Astro.props as { post: Post };
const d = post.data;
---
<article class="card" data-category={d.category}>
  <a href={postUrl(post)} class="link">
    <div class="thumb">
      {d.image ? <img class="photo" src={sized(d.image, 750)} alt={d.imageAlt || ""} loading="lazy" width="750" height="469" /> : <div class="ph" aria-hidden="true">VW</div>}
    </div>
    <div class="body">
      <p class="meta"><span class="cat">{d.category}</span><span>{readingTime(post.body)} min read</span></p>
      <h3>{d.title}</h3>
      <p class="desc">{d.description}</p>
    </div>
  </a>
</article>

<style>
  .card { background: var(--white); color: var(--black); border: 2px solid var(--black); }
  .card:hover { outline: 3px solid var(--purple); outline-offset: 2px; }
  .card:hover h3 { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .link { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .thumb { aspect-ratio: 16 / 10; background: var(--black); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .ph { height: 100%; display: grid; place-items: center; color: var(--white); font: 600 4.5rem/1 var(--display); letter-spacing: var(--track); }
  .body { padding: 22px 22px 24px; display: flex; flex-direction: column; flex: 1; border-top: 6px solid var(--purple); }
  .meta { display: flex; gap: 12px; align-items: baseline; font-size: 0.9rem; margin-bottom: 10px; }
  .cat { font-weight: 700; }
  h3 { font-size: var(--fs-card); margin-bottom: 10px; }
  .desc { font-size: 0.98rem; flex: 1; }
</style>
