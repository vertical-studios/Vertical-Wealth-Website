---
import { tf } from "../../lib/tina";
import { toneClass } from "../../lib/tone";
const { text, reference, tone } = Astro.props;
---
<section class:list={["section verse", toneClass(tone)]} data-tina-field={tf(Astro.props)}>
  <figure class="wrap">
    <blockquote data-tina-field={tf(Astro.props, "text")}>{text}</blockquote>
    {reference && <figcaption data-tina-field={tf(Astro.props, "reference")}>{reference}</figcaption>}
  </figure>
</section>
<style>
  figure { margin-block: 0; }
  blockquote { margin: 0; max-width: 30ch; font: 600 clamp(1.9rem, 1.3rem + 2vw, 2.8rem)/1 var(--display); letter-spacing: var(--track); text-wrap: balance; }
  figcaption { display: inline-block; margin-top: 24px; padding: 6px 12px 4px; background: var(--accent); color: var(--accent-ink); font: 600 1.2rem/1 var(--display); letter-spacing: var(--track); }
</style>
