---
import { tf } from "../../lib/tina";
import { toneClass } from "../../lib/tone";
const { items = [], tone } = Astro.props;
---
<section class:list={["stats", toneClass(tone)]} data-tina-field={tf(Astro.props)}>
  <ul class="wrap">
    {items?.map((s: any) => (
      <li data-tina-field={tf(s)}><strong data-tina-field={tf(s, "value")}>{s.value}</strong><span data-tina-field={tf(s, "label")}>{s.label}</span></li>
    ))}
  </ul>
</section>
<style>
  .stats { padding-block: 40px; border-top: 2px solid var(--line); border-bottom: 2px solid var(--line); }
  ul { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 28px; }
  strong { display: block; font: 600 var(--fs-stat)/0.9 var(--display); letter-spacing: var(--track); color: var(--accent); }
  span { display: block; margin-top: 6px; font-weight: 500; }
</style>
