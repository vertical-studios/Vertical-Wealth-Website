---
import Buttons from "../Buttons.astro";
import { sized, srcset } from "../../lib/img";
import { tf } from "../../lib/tina";
const { eyebrow, headline, body, image, imageAlt, buttons, index } = Astro.props;
const first = index === 0;
// A headline made of short sentences ("Live boldly. Give generously.") sets one sentence per line.
const lines: string[] = (headline || "").match(/[^.!?]+[.!?]+/g)?.map((x: string) => x.trim()) || [];
const Tag = first ? "h1" : "h2";
---
<section class:list={["hero on-white", { "has-img": image }]} data-tina-field={tf(Astro.props)}>
  <div class="wrap inner">
    <div class="copy">
      {eyebrow && <p class="tag" data-tina-field={tf(Astro.props, "eyebrow")}>{eyebrow}</p>}
      <Tag data-tina-field={tf(Astro.props, "headline")}>{lines.length > 1 ? lines.map((l) => <span class="ln">{l}</span>) : headline}</Tag>
      {body && <p class="lede" data-tina-field={tf(Astro.props, "body")}>{body}</p>}
      <Buttons buttons={buttons} />
    </div>
    {image && (
      <figure class="media" data-tina-field={tf(Astro.props, "image")}>
        <img class="photo" src={sized(image, 1500)} srcset={srcset(image)} sizes="(max-width: 900px) 100vw, 46vw" alt={imageAlt || ""} loading={first ? "eager" : "lazy"} fetchpriority={first ? "high" : "auto"} />
      </figure>
    )}
  </div>
</section>
<style>
  .hero { padding-block: clamp(56px, 8vw, 104px); }
  .inner { display: grid; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .has-img .inner { grid-template-columns: 1.05fr 1fr; }
  h1, h2 { max-width: 16ch; }
  .ln { display: block; }
  h2 { font-size: var(--fs-h1); }
  /* The purple edge: Wealth's one vertical accent */
  .media { margin: 0; border-left: 12px solid var(--accent); }
  .media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 25%; }
  @media (max-width: 900px) { .has-img .inner { grid-template-columns: 1fr; } }
</style>
