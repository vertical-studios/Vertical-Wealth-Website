---
// VERTICAL FAMILY SHELL: shared footer, identical in every site repo.
// Layout and sizes are fixed here; each site sets its colors with the --ftr-* tokens in global.css
// and its names, links and details in Site settings.
const { settings } = Astro.props;
const year = new Date().getFullYear();
const name = settings.siteName || "Vertical";
// Group footer links into columns by their optional "section".
const cols: { name: string; links: any[] }[] = [];
(settings.footerLinks || []).forEach((l: any) => {
  const sec = l.section || "";
  const last = cols[cols.length - 1];
  if (last && last.name === sec) last.links.push(l);
  else cols.push({ name: sec, links: [l] });
});
const tel = (settings.phone || "").replace(/[^0-9+]/g, "");
const ext = (h: string) => /^https?:/.test(h || "");
const cta = { href: settings.navCta?.href || "/", label: settings.navCta?.label || "Get started" };
---
<footer class="site-footer">
  <div class="wrap top">
    <div class="id">
      {(settings.logoStacked || settings.logo) && <img class="mark" src={settings.logoStacked || settings.logo} alt={name} width="220" height="50" loading="lazy" />}
      {settings.tagline && <p class="tagline">{settings.tagline}</p>}
      {settings.verse && <p class="verse">{settings.verse}</p>}
    </div>
    <div class="contact">
      <p class="fh">{settings.contactHeading || "Talk with us"}</p>
      {settings.locationNote && <p>{settings.locationNote}</p>}
      {settings.address && <address>{settings.address}</address>}
      {settings.phone && <p><a href={`tel:${tel}`}>{settings.phone}</a></p>}
      {settings.email && <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>}
      <a class="btn btn-primary" href={cta.href}>{cta.label}</a>
      {settings.footerActions?.length > 0 && (
        <ul class="actions">
          {settings.footerActions.map((a: any) => <li><a href={a.href} {...(ext(a.href) ? { target: "_blank", rel: "noopener" } : {})}>{a.label}</a></li>)}
        </ul>
      )}
    </div>
    <nav class="cols" aria-label="Footer">
      {cols.map((c) => (
        <div>
          {c.name && <p class="fh">{c.name}</p>}
          <ul>{c.links.map((l: any) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </nav>
  </div>
  {settings.family?.length > 0 && (
    <div class="wrap family">
      <p class="fh">{settings.familyHeading || "Part of Vertical Life"}</p>
      <ul>
        {settings.family.map((f: any) => (
          <li><a href={f.href} target="_blank" rel="noopener" aria-label={f.label}>{f.logo ? <img src={f.logo} alt={f.label} loading="lazy" width="180" height="40" /> : f.label}</a></li>
        ))}
      </ul>
    </div>
  )}
  <div class="wrap base">
    <span>&copy; {year} {name}</span>
    <ul class="social">{(settings.social || []).map((s: any) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
    <ul class="legal">{(settings.legal || []).map((l: any) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  </div>
  {settings.disclosures?.length > 0 && (
    <div class="wrap disc">
      {settings.disclosures.map((d: string) => <p class="fine">{d}</p>)}
    </div>
  )}
</footer>

<style>
  .site-footer {
    background-color: var(--ftr-bg, #000); color: var(--ftr-fg, #fff);
    border-top: var(--rule) solid var(--ftr-rule, var(--hdr-rule, var(--accent)));
    padding-top: clamp(56px, 7vw, 88px);
    --fg: var(--ftr-fg, #fff); --bg: var(--ftr-bg, #000); --line: var(--ftr-fg, #fff);
    --btn-hover-bg: var(--ftr-fg, #fff); --btn-hover-fg: var(--ftr-bg, #000);
    --focus: var(--ftr-head, #fcc602);
  }
  .top { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(220px, 1fr) 2fr; gap: 48px; }
  .mark { width: 220px; height: auto; margin-bottom: 18px; }
  .tagline { font: 600 2.2rem/0.95 var(--display); letter-spacing: var(--track); color: var(--ftr-head, #fcc602); margin: 0 0 6px; max-width: 13ch; }
  .verse { font-size: 0.95rem; font-weight: 500; }
  .fh { font: 600 1.35rem/1 var(--display); letter-spacing: var(--track); color: var(--ftr-head, #fcc602); margin: 0 0 14px; }
  address { font-style: normal; margin-bottom: 10px; }
  .contact p { margin: 0 0 8px; }
  .contact a:not(.btn) { text-decoration-color: var(--ftr-head, #fcc602); text-underline-offset: 3px; }
  .contact .btn { margin-top: 14px; }
  .actions { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 6px; }
  .actions a { font-weight: 500; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 28px; }
  .cols ul, .family ul, .base ul { list-style: none; margin: 0; padding: 0; }
  .cols li { margin-bottom: 8px; }
  .cols a { text-decoration: none; font-weight: 500; }
  .cols a:hover { color: var(--ftr-head, #fcc602); text-decoration: underline; text-underline-offset: 4px; }
  .family { margin-top: 56px; padding-block: 28px; border-top: 2px solid var(--ftr-fg, #fff); }
  .family ul { display: flex; flex-wrap: wrap; gap: 20px 44px; align-items: center; }
  .family img { width: auto; height: 40px; }
  .family a { display: inline-flex; min-height: 44px; align-items: center; }
  .base { display: flex; flex-wrap: wrap; gap: 14px 32px; align-items: center; padding-block: 22px 32px; border-top: 2px solid var(--ftr-fg, #fff); font-size: var(--fs-small); }
  .base ul { display: flex; flex-wrap: wrap; gap: 6px 20px; }
  .social { margin-left: auto !important; }
  .base a { text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
  .base a:hover { color: var(--ftr-head, #fcc602); }
  .disc { padding-block: 0 40px; display: grid; gap: 10px; }
  .disc .fine { margin: 0; max-width: 110ch; }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr 1fr; } .cols { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .top { grid-template-columns: 1fr; } .social { margin-left: 0 !important; } }
</style>
