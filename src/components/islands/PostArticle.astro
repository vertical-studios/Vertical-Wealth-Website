---
// A blog post's header, cover image, article and FAQs. The live page passes
// Astro's rendered Markdown in the "body" slot; /tina-island/post renders the
// editor's unsaved text through the same Markdown helper the pages use.
import Faq from "../blocks/Faq.astro";
import { readingTime, formatDate } from "../../lib/posts";
import { sized, srcset } from "../../lib/img";
import { richText } from "../../lib/richtext";
import { tf } from "../../lib/tina";

const { post: d, body = "" } = Astro.props as { post: any; body?: string };
const date = d?.date ? new Date(d.date) : null;
---
{d && (
  <>
    <header class="post-head">
      <div class="wrap narrow">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/blog">Blog</a> <span aria-hidden="true">/</span> <span data-tina-field={tf(d, "category")}>{d.category}</span></nav>
        <h1 data-tina-field={tf(d, "title")}>{d.title}</h1>
        <p class="dek" data-tina-field={tf(d, "description")}>{d.description}</p>
        <p class="meta">
          {date && <time datetime={date.toISOString()} data-tina-field={tf(d, "date")}>{formatDate(date)}</time>}, {readingTime(body)} min read, by <span data-tina-field={tf(d, "author")}>{d.author}</span>
        </p>
      </div>
    </header>
    {d.image && (
      <figure class="cover wrap" data-tina-field={tf(d, "image")}>
        <img src={sized(d.image, 1500)} srcset={srcset(d.image)} sizes="(max-width: 1180px) 100vw, 1180px" alt={d.imageAlt || ""} width="1500" height="844" fetchpriority="high" />
      </figure>
    )}
    <div class="wrap narrow section-sm">
      <div class="article prose" data-tina-field={tf(d, "body")}>
        <slot name="body"><Fragment set:html={richText(body)} /></slot>
      </div>
    </div>
    {d.faqs?.length ? <Faq heading="Common questions" items={d.faqs} faqField={tf(d, "faqs")} /> : null}
  </>
)}

<style>
  .narrow { max-width: 760px; }
  .post-head { background: var(--black); color: var(--white); --fg: var(--white); border-bottom: 4px solid var(--purple); padding-block: clamp(64px, 9vw, 112px) clamp(40px, 5vw, 64px); }
  .post-head h1 { font-size: clamp(2.4rem, 1.7rem + 2.6vw, 3.6rem); max-width: 20ch; }
  .crumbs { font-size: 0.85rem; color: var(--white); margin-bottom: 18px; }
  .crumbs a { color: var(--yellow); text-decoration: none; font-weight: 700; }
  .dek { font-size: 1.2rem; color: var(--white); }
  .meta { color: var(--white); font-size: 0.9rem; margin: 0; }
  .cover { margin: -24px auto 0; }
  .cover img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; filter: grayscale(1) contrast(1.06); }
  .section-sm { padding-block: clamp(40px, 6vw, 72px); }
  .article { font-size: 1.12rem; line-height: 1.75; overflow-wrap: break-word; }
  .article :global(h2) { font-size: clamp(2rem, 4vw, 2.7rem); margin-top: 1.6em; }
  .article :global(h3) { font-size: 1.7rem; margin-top: 1.4em; }
  .article :global(a) { color: inherit; text-decoration-color: var(--purple); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .article :global(blockquote) { margin: 1.6em 0; padding: 4px 0 4px 22px; border-left: 6px solid var(--purple); font-size: 1.25rem; font-style: italic; }
  .article :global(table) { width: 100%; border-collapse: collapse; margin: 1.5em 0; font-size: 0.98rem; }
  .article :global(th), .article :global(td) { text-align: left; padding: 10px 12px; border-bottom: 2px solid var(--black); vertical-align: top; }
  .article :global(th) { background: var(--purple); color: var(--white); }
  .article :global(li) { margin-bottom: 0.45em; }
</style>
