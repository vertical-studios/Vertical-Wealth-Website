{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/new-dropdown",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-1",
      "destination": "/our-approach",
      "permanent": true
    },
    {
      "source": "/values",
      "destination": "/our-approach",
      "permanent": true
    },
    {
      "source": "/services-1",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/quotes",
      "destination": "/life-insurance",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "/guides",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/thank-you",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
